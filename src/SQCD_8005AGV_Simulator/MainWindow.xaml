<Window x:Class="SQCD_8005AGV_Simulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQCD 8005 AGV 仓位 IO 仿真器"
        Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        Background="{StaticResource PageBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Microsoft YaHei UI"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="6" />
            <RowDefinition Height="150" MinHeight="96" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#204F70" CornerRadius="10" Padding="15,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SQCD 8005 AGV 仓位 IO 仿真器" Foreground="#F7FBFF" FontSize="20" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Foreground="#D4E3ED" FontSize="12">
                            <Run Text="Modbus TCP："/><Run Text="{Binding Endpoint, Mode=OneWay}"/><Run Text="  ·  Unit ID："/><Run Text="{Binding UnitIdText, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Foreground="#D4E3ED" FontSize="12" Margin="14,0,0,0">
                            <Run Text="HTTP："/><Run Text="{Binding HttpEndpoint, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#DDF5E8" CornerRadius="12" Padding="10,5" Margin="0,0,10,0">
                        <TextBlock Text="{Binding ServerStatus}" Foreground="#187047" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" />
                    </Border>
                    <Button Content="启动服务" Click="StartServer_Click" Style="{StaticResource HeaderButtonStyle}" />
                    <Button Content="停止服务" Click="StopServer_Click" Style="{StaticResource HeaderButtonStyle}" />
                    <Button Content="断开客户端" Click="DisconnectClients_Click" Style="{StaticResource HeaderButtonStyle}" />
                    <Button Content="安全 Reset" Click="Reset_Click" Style="{StaticResource ResetButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource SoftBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="原始 IO（1=继电器闭合 / DI短接GND）" FontWeight="SemiBold" DockPanel.Dock="Left" />
                    <CheckBox Content="故障：保持连接但不响应 Modbus 请求" IsChecked="{Binding IgnoreRequests}" DockPanel.Dock="Right" Foreground="#40586C" />
                </DockPanel>
                <Border Background="#EDF3F7" CornerRadius="5" Padding="8,4" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding RawDo}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="#29465C" />
                        <TextBlock Text="{Binding RawDi}" Margin="0,2,0,0" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="#29465C" />
                    </StackPanel>
                </Border>
                <Border Visibility="{Binding GlobalFaultVisibility}" Background="#FFF1F2" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="0,9,0,0">
                    <TextBlock Text="{Binding GlobalFaultSummary}" Foreground="#991B1B" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
            <ItemsControl ItemsSource="{Binding Slots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" Rows="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding StatusBrush}" BorderBrush="{Binding StatusBorderBrush}" BorderThickness="{Binding StatusBorderThickness}" CornerRadius="8" Margin="4" Padding="10,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,3">
                                    <Border Background="{Binding StatusBadgeBrush}" CornerRadius="10" Padding="8,2" DockPanel.Dock="Right">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                                </DockPanel>
                                <TextBlock Text="{Binding ChannelText}" Foreground="{StaticResource TextMuted}" FontSize="11" />
                                <Separator Margin="0,5" Background="#D8E1E9" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="0.85*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DoText}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DoorText}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LockText}" Margin="0,3,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CargoText}" Margin="0,3,0,0" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding LightText}" Margin="0,3,0,0" />
                                </Grid>
                                <Border Visibility="{Binding FaultVisibility}" Background="#FFF8F8" BorderBrush="#E9A9A9" BorderThickness="1" CornerRadius="5" Padding="7,5" Margin="0,5,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FaultTitle}" Foreground="#B91C1C" FontWeight="Bold" FontSize="12" />
                                        <TextBlock Text="{Binding FaultDetails}" Foreground="#991B1B" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>

                                <WrapPanel Margin="0,5,0,0">
                                    <Button Content="放料" Tag="{Binding SlotIndex}" Click="PlaceCargo_Click" Style="{StaticResource ActionButtonStyle}" />
                                    <Button Content="取料" Tag="{Binding SlotIndex}" Click="RemoveCargo_Click" Style="{StaticResource ActionButtonStyle}" />
                                    <Button Content="关闭仓门" Tag="{Binding SlotIndex}" Click="CloseDoor_Click" Style="{StaticResource ActionButtonStyle}" />
                                </WrapPanel>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="锁反馈故障" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                    <WrapPanel Grid.Row="0" Grid.Column="1">
                                        <Button Content="正常" Tag="{Binding SlotIndex}" Click="LockNormal_Click" Background="{Binding LockNormalButtonBrush}" Style="{StaticResource CompactButtonStyle}" />
                                        <Button Content="固定0" Tag="{Binding SlotIndex}" Click="LockZero_Click" Background="{Binding LockZeroButtonBrush}" Style="{StaticResource CompactButtonStyle}" />
                                        <Button Content="固定1" Tag="{Binding SlotIndex}" Click="LockOne_Click" Background="{Binding LockOneButtonBrush}" Style="{StaticResource CompactButtonStyle}" />
                                    </WrapPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="光幕故障" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                    <WrapPanel Grid.Row="1" Grid.Column="1">
                                        <Button Content="正常" Tag="{Binding SlotIndex}" Click="LightNormal_Click" Background="{Binding LightNormalButtonBrush}" Style="{StaticResource CompactButtonStyle}" />
                                        <Button Content="固定0" Tag="{Binding SlotIndex}" Click="LightZero_Click" Background="{Binding LightZeroButtonBrush}" Style="{StaticResource CompactButtonStyle}" />
                                        <Button Content="固定1" Tag="{Binding SlotIndex}" Click="LightOne_Click" Background="{Binding LightOneButtonBrush}" Style="{StaticResource CompactButtonStyle}" />
                                    </WrapPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#CBD8E3" Cursor="SizeNS" />

        <Border Grid.Row="4" Background="#F7FAFC" BorderBrush="{StaticResource SoftBorder}" BorderThickness="1" CornerRadius="8" Padding="9,7" Margin="0,3,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="3,0,3,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox x:Name="AutoScrollLogsCheckBox" Content="自动滚动" IsChecked="True" Foreground="#40586C" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <CheckBox Content="记录周期读取（FC01/FC02）" IsChecked="{Binding LogReadRequests}" Foreground="#40586C" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button Content="清空" Click="ClearLogs_Click" Padding="8,2" MinHeight="24" />
                    </StackPanel>
                    <TextBlock Text="运行日志（最多 500 条）" Foreground="#29465C" FontWeight="SemiBold" />
                </DockPanel>
                <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Logs}" Background="#F7FAFC" Foreground="#334E63" BorderThickness="0" FontFamily="Consolas" FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</Window>
